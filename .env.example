# Environment Configuration for FinTrack

# Neon PostgreSQL connection string (Pooled connection with pgbouncer)
DATABASE_URL="postgresql://[user]:[password]@[neon-hostname]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require"

# Neon PostgreSQL direct connection string (Direct connection for migrations)
DIRECT_URL="postgresql://[user]:[password]@[neon-hostname].[region].aws.neon.tech/[dbname]?sslmode=require"

# Secret key for authentication token and session encryption (generate with `openssl rand -base64 32`)
AUTH_SECRET="your-super-secret-jwt-key-min-32-chars-long"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"
